# Application
PORT=3000
NODE_ENV=development

# Database
# Use your own postgres credentials for local development
DATABASE_URL="postgresql://user:password@localhost:5432/booking_platform?schema=public"

# Authentication
# Generate strong, random secrets in production (e.g., using `openssl rand -base64 32`)
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your_super_secret_refresh_key_here"
JWT_REFRESH_EXPIRES_IN="7d"
