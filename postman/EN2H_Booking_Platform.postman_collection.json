            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services/:id",
              "host": ["{{baseUrl}}"],
              "path": ["services", ":id"],
              "variable": [
                { "key": "id", "value": "{{serviceId}}" }
              ]
            }
          }
        }
      ]
    },
