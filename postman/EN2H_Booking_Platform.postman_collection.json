            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 59.99,\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/services/:id",
              "host": ["{{baseUrl}}"],
              "path": ["services", ":id"],
              "variable": [
                { "key": "id", "value": "{{serviceId}}" }
              ]
            }
          }
        },
        {
          "name": "Delete Service",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
